        <!-- Legend / notes -->
        <mxCell id="note" value="&#8226; Todo funciona dentro de la red WiFi del local, sin depender de Internet.&lt;br&gt;&#8226; Los empleados (Bloque 3) solo llegan a los datos a trav&#233;s de la API (Bloque 2); nunca acceden directo a la base de datos.&lt;br&gt;&#8226; El administrador usa el panel web completo (Bloque 1) desde la PC o tablet del mostrador." style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="920" height="60" as="geometry" />
        </mxCell>

      </root>
