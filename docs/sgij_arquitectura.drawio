        <mxCell id="devices" value="DISPOSITIVOS EN LA TIENDA (mismo WiFi)" style="rounded=1;strokeColor=#CC6600;fillColor=#FFF5E6;verticalAlign=top;align=center;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="440" height="400" as="geometry" />
        </mxCell>

        <mxCell id="dev1" value="PC / Tablet del Mostrador&lt;br&gt;(Navegador web)&lt;br&gt;Usado por el Administrador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
