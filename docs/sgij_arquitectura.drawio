        </mxCell>

        <mxCell id="bd" value="Base de Datos SQLite&lt;br&gt;(jugueteria.db)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;boundedLbl=1;" vertex="1" parent="1">
