        </mxCell>

        <mxCell id="b1" value="BLOQUE 1&lt;br&gt;Panel de Administraci&#243;n (Flask - Web)&lt;br&gt;Inventario, Ventas, Personal, Kardex,&lt;br&gt;Aprobaci&#243;n de ventas pendientes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="150" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="BLOQUE 2&lt;br&gt;API (Flask - JSON)&lt;br&gt;Endpoints: productos por c&#243;digo, carrito,&lt;br&gt;crear venta, subir foto de factura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
