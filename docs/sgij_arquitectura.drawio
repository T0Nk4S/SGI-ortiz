<mxfile host="app.diagrams.net">
  <diagram name="SGIJ - Arquitectura 3 Bloques" id="sgij-arch">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Arquitectura SGIJ &#8212; Sistema de Gesti&#243;n + API + App Flutter (Red Local)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- Outer LAN boundary -->
        <mxCell id="net" value="RED LOCAL DEL NEGOCIO (WiFi) &#8212; SIN CONEXI&#211;N A INTERNET" style="rounded=1;dashed=1;strokeColor=#666666;fillColor=none;verticalAlign=top;align=center;fontSize=14;fontStyle=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1000" height="500" as="geometry" />
        </mxCell>

        <!-- PC Servidor container -->
        <mxCell id="pcserver" value="PC SERVIDOR&lt;br&gt;IP local fija (ej. 192.168.1.50)" style="rounded=1;strokeColor=#0066CC;fillColor=#F5F9FF;verticalAlign=top;align=center;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1">
